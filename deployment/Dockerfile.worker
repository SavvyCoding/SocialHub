# ── Stage 1: Install dependencies (include devDeps for tsx) ──
FROM node:22-alpine AS deps
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile

# ── Stage 2: Production ──
FROM node:22-alpine AS runner
RUN apk add --no-cache tini
WORKDIR /app

RUN addgroup --system --gid 1001 appgroup && \
    adduser --system --uid 1001 appuser

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY apps/web/server ./apps/web/server
COPY apps/web/lib ./apps/web/lib
COPY apps/web/prisma ./apps/web/prisma
COPY apps/web/tsconfig.json ./apps/web/tsconfig.json
COPY apps/web/package.json ./apps/web/package.json
COPY package.json pnpm-workspace.yaml ./

# Generate Prisma client
RUN ./apps/web/node_modules/.bin/prisma generate --schema apps/web/prisma/schema.prisma

ENV NODE_ENV=production
ENV PATH="/app/apps/web/node_modules/.bin:/app/node_modules/.bin:$PATH"

USER appuser

ENTRYPOINT ["/sbin/tini", "--"]
WORKDIR /app/apps/web
CMD ["tsx", "server/worker.ts"]
