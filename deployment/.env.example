# --- Database ---
POSTGRES_DB=social_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://postgres:change-me-in-production@postgres:5432/social_platform
DIRECT_DATABASE_URL=postgresql://postgres:change-me-in-production@postgres:5432/social_platform

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# --- Auth.js (generate with: openssl rand -base64 32) ---
AUTH_SECRET=
NEXTAUTH_URL=https://your-domain.com

# --- OAuth Providers ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Socket.IO ---
SOCKET_SERVER_URL=http://socket:3001
NEXT_PUBLIC_SOCKET_URL=https://your-domain.com/socket

# --- Embeddings (local model via OpenUI / Ollama) ---
EMBEDDING_API_URL=http://localhost:11434/api/embed
EMBEDDING_MODEL=nomic-embed-text

# --- Optional services ---
TMDB_READ_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=
RESEND_API_KEY=
SENTRY_DSN=

# ── Optional: operations and scaling (see .env.example at the repo root for details) ──
LOG_LEVEL=info
NEXT_PUBLIC_APP_URL=https://your-domain.example
WEB_URL=https://your-domain.example
NEXT_PUBLIC_TMDB_CONFIGURED=
DATABASE_READ_URL=
REDIS_SENTINELS=
REDIS_SENTINEL_MASTER=mymaster
SENTRY_ORG=
SENTRY_PROJECT=
