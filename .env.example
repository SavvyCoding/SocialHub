# Database (Docker local default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_platform
# Direct connection for migrations (same as DATABASE_URL unless you run PgBouncer in front)
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_platform

# Redis (Docker local default)
REDIS_URL=redis://localhost:6379

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (get from Google Cloud Console / GitHub Developer Settings)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Cloudinary (get from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# TMDB (get from themoviedb.org — Phase 5)
TMDB_READ_ACCESS_TOKEN=

# Mapbox (get from mapbox.com — Phase 6)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Resend (get from resend.com — Phase 7)
RESEND_API_KEY=

# Embeddings (local model via OpenUI / Ollama)
EMBEDDING_API_URL=http://localhost:11434/api/embed
EMBEDDING_MODEL=nomic-embed-text

# Socket.IO Server URL (Phase 2)
SOCKET_SERVER_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ── Optional: operations and scaling ─────────────────────────────────────────
# Pino log level for web and socket server (default: debug in dev, info in prod)
LOG_LEVEL=info
# Public URL of the web app, used in emails such as the weekly digest
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Allowed origin for the socket server's CORS (the web app's URL)
WEB_URL=http://localhost:3000
# Set to 1 at build time when TMDB_READ_ACCESS_TOKEN is configured, so the movie
# search does not show its "TMDB not configured" hint
NEXT_PUBLIC_TMDB_CONFIGURED=
# Read replica for Prisma (leave empty to read from the primary)
DATABASE_READ_URL=
# Redis Sentinel: comma-separated host:port list and master name (leave empty for a single Redis)
REDIS_SENTINELS=
REDIS_SENTINEL_MASTER=mymaster
# Sentry source-map upload at build time (needs SENTRY_AUTH_TOKEN too); leave empty to skip
SENTRY_ORG=
SENTRY_PROJECT=
